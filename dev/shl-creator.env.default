# Example docker-compose environment file
# Copy to shl-creator.env and modify as necessary
# https://docs.docker.com/compose/env-file/

# Variables defined in this file will only be available to containers/images
# ie not for interpolation in docker-compose YAML files

# API Key for NIO Autocoder API
AUTOCODER_API_KEY=

# Bearer auth tokens for fhir url fetch list
MEDITECH_BEARER_TOKEN=
EPIC_BEARER_TOKEN=

# SMART on FHIR client id configurations:
# Ensure that the client is registered with the proper redirect uris.
# EHR provider client ids:
VITE_EPIC_CLIENT_ID=
VITE_CERNER_CLIENT_ID=


# Optional configurations:

# Instance configuration
VITE_INSTANCE_ID=WAHealthSummary

# Specific url of viewer to use, if not at the shl-creator domain
#VITE_VIEWER_BASE=

# Client ID for SoF authentication
#VITE_SOF_CLIENT_ID=

# Debug option to build production source maps (Chrome dev tools recommended)
#DEBUG=1

# Add demo tab to IPS viewer
#VITE_SHOW_VIEWER_DEMO=1

# Show demo no-phi warning
VITE_DEMO_WARNING=1

# System type string shown in demo warning
# VITE_SYSTEM_TYPE=

# SHC Signing keys
# Values should be minified JSON strings wrapped in single quotes, e.g.
# '{"kty":"EC","d":"SuXXrr8h3e2PtZmBr1fbHFJZR_Uyd89GbJeFUGzKfw0","use":"sig","crv":"P-256","kid":"Doec_6TM0uqJGtEPuNWVCyHBtEoIlL23HfXFEyFw39M","x":"QRkTlI6aM3T39MKYp5CMMt1K1TaKTmnzrPipn2GIjEk","y":"oOWRFQWxJVbcRKqR7saNtxtvb9WSkWJO8Sano_-CSfk","alg":"ES256"}'

# Generate via https://mkjwk.org/ or another JWK generator service/lib
# Options:
#  type=EC
#  use=signature
#  crv=P-256
#  algorithm=ES256: ECDSA using P-256 and SHA-256
#  kid=SHA-256

# The private signing JWK, which includes the private "d" value
SHC_PRIVATE_JWK=''

# The list of public signing JWKs to honor, which DO NOT include the private "d" value
SHC_PUBLIC_JWK_STORE='{"keys":[]}'
